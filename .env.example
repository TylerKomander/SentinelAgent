# Copy this file to .env. The app runs with no credential — the dashboard and
# sensors work, but AI triage is disabled until you provide ONE of the two below.
#
# Pick your AI backend:
#   1. API key (pay-per-token)       -> set ANTHROPIC_API_KEY
#   2. Claude subscription (Pro/Max) -> set CLAUDE_CODE_OAUTH_TOKEN
#   3. A local model, no cloud       -> set SENTINEL_LOCAL_BASE_URL
# If several are set, SENTINEL_PROVIDER decides; otherwise it auto-selects.

# Backend 1 — Anthropic API key. Provider: sdk
ANTHROPIC_API_KEY=

# Backend 2 — your Claude Pro/Max subscription. Provider: claude_agent
# Requires the Claude Code CLI installed, then run `claude setup-token` and paste
# the token here. Also: pip install claude-agent-sdk
CLAUDE_CODE_OAUTH_TOKEN=

# Backend 3 — any OpenAI-compatible server. Provider: local
# Ollama: `ollama serve` then SENTINEL_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1 . No new Python dependency is needed.
# The model must support tool calling; pick one that does (e.g. qwen2.5, llama3.1,
# mistral-nemo). Weak tool support degrades to reading a JSON verdict from the reply.
SENTINEL_LOCAL_BASE_URL=
SENTINEL_LOCAL_MODEL=
SENTINEL_LOCAL_API_KEY=

# Force a backend: sdk | claude_agent | local  (blank = auto-detect from the above)
SENTINEL_PROVIDER=

# Optional overrides. SENTINEL_MODEL names the hosted model; the local backend uses
# SENTINEL_LOCAL_MODEL and falls back to this.
SENTINEL_MODEL=claude-opus-4-8

# Where the agent saves incident reports and reads prior context (its memory vault).
# Point this at a folder inside an Obsidian vault (use Obsidian Sync for web/mobile).
# Defaults to ./data/vault if unset.
OBSIDIAN_VAULT_PATH=

# Unattended remediation master switch. Off unless set to 1/true/yes/on. Even when
# armed, a fix only runs if its rule in config/rules.yaml opts in, the verdict target
# was observed in real tool output, and the command matches an approved shape.
SENTINEL_AUTO_REMEDIATE=

# Repeat alerts with the same signature and endpoints collapse into one dashboard
# card inside this many seconds. A single port scan is thousands of IDS events; this
# is what keeps the queue readable. Default 300. Set to 0 to see every event.
SENTINEL_DEDUP_WINDOW=

# Real alert feed: path to Suricata's eve.json. If set, the app tails it and pushes
# real IDS detections into the dashboard queue. Blank = demo feed only.
SURICATA_EVE_PATH=
